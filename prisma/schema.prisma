
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  muxLiveSessions MuxLiveSession[]
  rtmpSessions  RtmpSession[]
  transcriptSessions TranscriptSession[]

  @@unique([email])
  @@map("user")
}

enum MuxProcessingStatus {
  connecting
  connected
  paused
  transcribing
  disconnected
  error
}

enum MuxLiveStatus {
  active
  deleted
  disabled
  idle
}

enum TranscriptSessionSource {
  microphone
  livestream
  mux
  rtmp
}

enum SharedSessionSource {
  microphone
  livestream
}

enum SharedSessionStatus {
  active
  ended
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model MuxLiveSession {
  id           String              @id
  ownerUserId  String
  owner        User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  hostToken    String              @unique
  ingestToken  String              @unique
  sharedSessionId String           @unique
  sharedSessionCode String         @unique
  sharedSessionHostToken String
  streamKey    String
  publishUrl   String
  playbackId   String?
  playbackUrl  String?
  audioOnly    Boolean             @default(true)
  muxStatus    MuxLiveStatus       @default(idle)
  status       MuxProcessingStatus @default(connecting)
  error        String?
  workerRunning Boolean            @default(false)
  hasEverBeenActive Boolean        @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  endedAt      DateTime?
  entries      MuxTranscriptEntry[]

  @@index([ownerUserId, endedAt, updatedAt(sort: Desc)])
  @@index([endedAt, updatedAt(sort: Desc)])
  @@map("mux_live_session")
}

model MuxTranscriptEntry {
  id            String         @id @default(cuid())
  sessionId     String
  session       MuxLiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  lowConfidence Boolean?
  timestampMs   Int
  createdAt     DateTime       @default(now())

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("mux_transcript_entry")
}

model RtmpSession {
  id            String              @id
  ownerUserId   String
  owner         User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  hostToken     String              @unique
  ingestToken   String              @unique
  streamKey     String              @unique
  publishUrl    String
  sourceTitle   String?
  status        MuxProcessingStatus @default(connecting)
  error         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  endedAt       DateTime?
  entries       RtmpTranscriptEntry[]

  @@index([ownerUserId, endedAt, updatedAt(sort: Desc)])
  @@index([endedAt, updatedAt(sort: Desc)])
  @@map("rtmp_session")
}

model RtmpTranscriptEntry {
  id            String      @id @default(cuid())
  sessionId     String
  session       RtmpSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  lowConfidence Boolean?
  timestampMs   Int
  createdAt     DateTime    @default(now())

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("rtmp_transcript_entry")
}

model SharedSession {
  id          String              @id
  code        String              @unique
  hostToken   String              @unique
  sourceType  SharedSessionSource
  sourceTitle String?
  status      SharedSessionStatus @default(active)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  endedAt     DateTime?
  entries     SharedSessionEntry[]

  @@index([endedAt, updatedAt(sort: Desc)])
  @@map("shared_session")
}

model SharedSessionEntry {
  id            String        @id @default(cuid())
  sessionId     String
  session       SharedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  lowConfidence Boolean?
  timestampMs   Int
  createdAt     DateTime      @default(now())

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("shared_session_entry")
}

model TranscriptSession {
  id          String                  @id @default(cuid())
  ownerUserId String
  owner       User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  title       String
  sourceType  TranscriptSessionSource
  sourceTitle String?
  previewText String?
  entryCount  Int                     @default(0)
  archivedAt  DateTime?
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  entries     TranscriptSessionEntry[]

  @@index([ownerUserId, archivedAt, updatedAt(sort: Desc)])
  @@index([ownerUserId, updatedAt(sort: Desc)])
  @@map("transcript_session")
}

model TranscriptSessionEntry {
  id            String            @id @default(cuid())
  sessionId     String
  session       TranscriptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text          String
  lowConfidence Boolean?
  timestampMs   Int
  createdAt     DateTime          @default(now())

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("transcript_session_entry")
}
